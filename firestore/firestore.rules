rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(parejaId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/parejas/$(parejaId)).data.miembros;
    }

    match /codigosUnion/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /parejas/{parejaId} {
      allow create: if signedIn() && request.resource.data.miembros.size() == 1 && request.auth.uid in request.resource.data.miembros;
      allow read: if isMember(parejaId);
      allow update: if isMember(parejaId)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros'])
            && request.auth.uid in request.resource.data.miembros
            && resource.data.miembros.size() == 1
            && request.resource.data.miembros.size() == 2);
      allow delete: if isMember(parejaId) && resource.data.creadorId == request.auth.uid;

      match /movimientos/{movimientoId} {
        allow read, delete: if isMember(parejaId);
        allow create: if isMember(parejaId)
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.cantidad > 0;
        allow update: if isMember(parejaId) && resource.data.usuarioId == request.auth.uid;
      }
    }
  }
}
